# Telegram-бот управления (BotFather)
BOT_TOKEN=
# Telegram ID Заказчика (единственный пользователь бота)
OWNER_ID=
# Telegram ID Исполнителя (получает критические уведомления), необязательно
EXECUTOR_ID=
# my.telegram.org -> API development tools (на аккаунт Заказчика)
API_ID=
API_HASH=
# Ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Хранить ТОЛЬКО на сервере, не в Git и не рядом с бэкапами БД
FERNET_KEY=
DB_PATH=data/bot.sqlite
PHOTO_DIR=data/photos
# Часовой пояс (GMT+6 = Бишкек)
TZ_OFFSET_HOURS=6
